# Copy this file to .env and replace both passwords before starting the stack.
DB_ROOT_PASSWORD=replace_with_a_unique_long_root_password
DB_USER=ferreteria_app
DB_PASSWORD=replace_with_a_different_unique_long_app_password
DB_NAME=ferreterianuevo
APP_PORT=8080
APP_BASE_URL=/

# Needed only with docker-compose.tailscale.yml; never commit a real key.
TS_AUTHKEY=replace_with_your_tailscale_auth_key
